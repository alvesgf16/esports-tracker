# Server-only PandaScore token (never EXPO_PUBLIC_). Free fixtures plan.
PANDASCORE_TOKEN=

# Set to 1 to fetch live fixtures via GET /api/matches.
# Leave unset to use sample fixtures for local debugging only.
EXPO_PUBLIC_LIVE_SCHEDULE=

# Optional IANA time zone when the runtime cannot resolve one (e.g. America/Edmonton).
EXPO_PUBLIC_TIMEZONE=
