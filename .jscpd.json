{
  "minTokens": 50,
  "minLines": 5,
  "threshold": 0,
  "format": ["typescript", "javascript", "tsx", "jsx"],
  "ignore": [
    "**/node_modules/**",
    "**/.expo/**",
    "**/dist/**",
    "**/ios/**",
    "**/android/**",
    "**/web-build/**",
    "**/coverage/**",
    "**/report/**"
  ],
  "reporters": ["console"]
}
